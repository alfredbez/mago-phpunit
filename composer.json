{
    "name": "alfredbez/mago-phpunit",
    "description": "PHPUnit support for the Mago static analyzer.",
    "type": "library",
    "license": "MIT",
    "keywords": ["mago", "phpunit", "static-analysis", "extension"],
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "carthage-software/mago": "~1.58.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "AlfredBez\\MagoPhpunit\\": "src/"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": true
    }
}
